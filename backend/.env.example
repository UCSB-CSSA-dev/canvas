# Written by `npx convex dev` into backend/.env.local (never commit that file).
CONVEX_DEPLOYMENT=
CONVEX_URL=

# The variables below live on the Convex deployment, not in this file.
# Set them with `npx convex env set NAME value` (add `--prod` for production):
#
#   SITE_URL                 Where the frontend is served, including the base path.
#                            Dev: http://localhost:3000   Prod: https://ucsb-cssa-dev.github.io/canvas
#   AUTH_GOOGLE_ID           Google OAuth client ID
#   AUTH_GOOGLE_SECRET       Google OAuth client secret
#   JWT_PRIVATE_KEY, JWKS    Generated by `npx @convex-dev/auth`
#   ALLOWED_EMAIL_DOMAIN     Optional, defaults to ucsb.edu
#   BOOTSTRAP_ADMIN_EMAIL    Optional: only this email may become the first system admin
