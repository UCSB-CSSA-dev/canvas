{
  "name": "@cssa-hub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:all": "convex dev --start \"npm run dev --prefix ../frontend\"",
